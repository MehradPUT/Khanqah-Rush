# Copy to .env for local testing (`node server/example.cjs`, `make webhook-*`).
# Never commit .env (see .gitignore). For `wrangler dev`, put local values
# in `.dev.vars` instead (also gitignored).

# --- Secrets (production: `wrangler secret put ...`) ---

# Bot token from BotFather (/newbot). Server-side only — never in the client.
TELEGRAM_BOT_TOKEN=

# Signs launch tokens and derives session keys. Defaults to the bot token
# if unset; use a dedicated random value in production.
SERVER_SECRET=

# Optional shared secret for the Telegram webhook (BotFather/setWebhook).
# Requests missing the X-Telegram-Bot-Api-Secret-Token header are rejected.
WEBHOOK_SECRET=

# --- Non-secret config (production: `wrangler.toml` [vars] or code defaults) ---

# Public HTTPS URL of the deployed game (Workers URL or custom domain).
# Required by the node server for Play-answer URLs and by `make webhook-set`.
# The Worker falls back to the request origin when unset.
GAME_URL=https://khanqah-rush.<your-account>.workers.dev

# Game short name from BotFather (/newgame). Must match the registered game.
# Already defaulted in `wrangler.toml` [vars] and the node server.
GAME_SHORT_NAME=khanqah_rush

# Bot username (without @), used in fallback texts.
# Already defaulted in `wrangler.toml` [vars] and the Worker.
BOT_USERNAME=KhanqahRushBot

# Local port for node server/example.cjs.
PORT=3000

# Dev-only score-debug flag (see docs/debugging.md): the score APIs attach
# reject reasons and the Worker logs per-update traffic. Local testing only
# (.env here, `.dev.vars` for `wrangler dev`) — never set in production.
DEBUG_SCORES=
