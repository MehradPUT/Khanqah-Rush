# Copy to .env for local testing. Never commit .env (see .gitignore).
# In production (Cloudflare) these become `wrangler secret put` secrets.

# Bot token from BotFather (/newbot). Server-side only — never in the client.
TELEGRAM_BOT_TOKEN=

# Signs launch tokens and derives session keys. Defaults to the bot token
# if unset; use a dedicated random value in production.
SERVER_SECRET=

# Public HTTPS URL of the deployed game (Workers URL or custom domain).
# Used as the Play-answer URL and shared-score links.
GAME_URL=https://khanqah-rush.<your-account>.workers.dev

# Game short name from BotFather (/newgame). Must match the registered game.
GAME_SHORT_NAME=khanqah_rush

# Optional shared secret for the Telegram webhook (BotFather/setWebhook).
# Requests missing the X-Telegram-Bot-Api-Secret-Token header are rejected.
WEBHOOK_SECRET=

# Local port for node server/example.cjs.
PORT=3000
